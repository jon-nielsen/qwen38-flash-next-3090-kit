+@triton.jit
+def _decode_e4m3_to_bf16(b):
+    # Shifting the 7 magnitude bits left by 7 lands the E4M3 exponent in the
+    # FP16 exponent field and the 3 mantissa bits at the top of the FP16
+    # mantissa field, giving the right number under the wrong exponent bias
+    # (E4M3 7 vs FP16 15). That is a constant factor of 2^8. E4M3 subnormals
+    # land on FP16 subnormals and the same factor renormalizes them, which is
+    # only true because sm_86 does not flush FP16 subnormals -- verified on
+    # device, not assumed (probes/e4m3_shiftmul_probe.py).
+    #
+    # Bit-exact against torch on all 254 finite codepoints: every E4M3 value
+    # fits in BF16's 7 mantissa bits, and x256 is exact in FP16.
+    #
+    # This replaced a branchless-but-long decoder (~18 ops, 8 nested selects)
+    # that sat in both the K and the V tile load and cost ~half of prefill
+    # throughput on sm_86.
+    #
+    # Overlay deviation: 0x7F/0xFF are NaN in e4m3fn but decode to +-480
+    # there (CUDA KV writer never emits them). PLE checkpoint tables can
+    # contain those codes, so after the proven finite arithmetic we map
+    # them to signed bf16 qNaN to match torch uint8.view(e4m3fn).to(bf16).
+    b = b.to(tl.uint16)
+    bits = ((b & 0x80) << 8) | ((b & 0x7F) << 7)
+    decoded = (bits.to(tl.uint16).to(tl.float16, bitcast=True) * 256.0).to(tl.bfloat16)
+    is_nan = (b & 0x7F) == 0x7F
+    nan_bits = ((b & 0x80) << 8) | 0x7FC0
+    nan_val = nan_bits.to(tl.uint16).to(tl.bfloat16, bitcast=True)
+    return tl.where(is_nan, nan_val, decoded)
+
+
+@triton.jit
+def _lookup_ple_fp8_embedding_from_pinned_kernel(
+    weight_ptr,
+    ids_ptr,
+    output_ptr,
+    embedding_dim,
+    tp_vocab_start,
+    tp_vocab_end,
+    BLOCK_D: tl.constexpr,
+):
+    """Look up TP-owned FP8 PLE rows through a uint8 CUDA view of pinned memory.
+
+    ``weight_ptr`` is a uint8 view of the e4m3fn table. Values are decoded to
+    bf16 inside the kernel so Triton never sees an 8-bit float pointer. The
+    unscaled decode is stored; ``dequantize`` still applies the global scale.
+    """
+    row_id = tl.program_id(0)
+    global_idx = tl.load(ids_ptr + row_id)
+    in_range = (global_idx >= tp_vocab_start) & (global_idx < tp_vocab_end)
+    local_idx = tl.where(in_range, global_idx - tp_vocab_start, 0)
+    offsets = tl.arange(0, BLOCK_D)
+    store_mask = offsets < embedding_dim
+    load_mask = store_mask & in_range
+    codes = tl.load(
+        weight_ptr + local_idx * embedding_dim + offsets,
+        mask=load_mask,
+        other=0,
+    )
+    values = _decode_e4m3_to_bf16(codes)
+    tl.store(
+        output_ptr + row_id * embedding_dim + offsets,
+        values,
+        mask=store_mask,
+    )
+
