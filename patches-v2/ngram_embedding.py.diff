+# Triton storage codes for the pinned-host lookup. E4M3 is always a uint8 view
+# so the kernel never receives an fp8e4nv pointer (illegal on sm80/sm86).
+_PLE_WEIGHT_DTYPE_NATIVE = 0
+_PLE_WEIGHT_DTYPE_E4M3 = 1
+
+
+def _view_ple_weight_as_triton_storage(
+    weight: torch.Tensor,
+) -> tuple[torch.Tensor, int]:
+    """Return a Triton-legal storage view of a PLE table plus a dtype code.
+
+    E4M3 is always a uint8 view: Triton must never see an fp8e4nv pointer on
+    sm80/sm86. BF16 and other non-FP8 dtypes pass through unchanged
+    (``_PLE_WEIGHT_DTYPE_NATIVE``). Shape and strides are preserved because
+    ``float8_e4m3fn`` and ``uint8`` are both one byte.
+    """
+    if weight.dtype == torch.float8_e4m3fn:
+        return weight.view(torch.uint8), _PLE_WEIGHT_DTYPE_E4M3
+    if weight.dtype == torch.uint8:
+        return weight, _PLE_WEIGHT_DTYPE_E4M3
+    return weight, _PLE_WEIGHT_DTYPE_NATIVE
+
 
