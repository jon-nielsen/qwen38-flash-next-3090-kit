+        )
+        raise ValueError(
+            "Qwen4Exp QSA E4M3 KV cache is validated only on SM86, but "
+            f"{current_platform.get_device_name()} has compute capability "
+            f"{cap_str}. Re-run with --kv-cache-dtype bfloat16."
+        )
+    return current_platform.fp8_dtype()
